config netmon 'main'
	option enabled '1'
	# Where the traffic database (flows.db) lives. It is written to every
	# minute, so use external storage rather than the router's flash. Put
	# GeoLite2-Country.mmdb and GeoLite2-ASN.mmdb here to get countries, the
	# networks of remote hosts and better app detection.
	option data_dir '/srv/netmon'
	# DNS servers for reverse lookups of hostnames: local addresses go to
	# the first, public ones to the second (host, host:port or 'system').
	option local_dns '127.0.0.1:53'
	option public_dns '8.8.8.8:53'
	# Delete hourly data older than this many days, 0 keeps everything.
	option retention_days '0'
