#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/netmon

start_service() {
	local enabled data_dir local_dns public_dns retention_days memory_limit threads dns_log

	config_load netmon
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get data_dir main data_dir /srv/netmon
	config_get local_dns main local_dns 127.0.0.1:53
	config_get public_dns main public_dns 8.8.8.8:53
	config_get retention_days main retention_days 0
	config_get memory_limit main memory_limit
	config_get threads main threads
	config_get dns_log main dns_log logread

	mkdir -p "$data_dir"

	# The kernel only keeps byte and packet counters for connections while
	# accounting is on, and those counters are what netmon reads.
	sysctl -w net.netfilter.nf_conntrack_acct=1 > /dev/null ||
		logger -t netmon "could not enable conntrack accounting, traffic will not be counted"

	# netmon keeps its database and looks for the GeoIP databases in its
	# working directory, which procd can't set, so change into it first.
	procd_open_instance
	procd_set_param command /bin/sh -c 'cd "$1" && exec "$2"' netmon "$data_dir" "$PROG"
	procd_set_param env \
		NETMON_LOCAL_DNS="$local_dns" \
		NETMON_PUBLIC_DNS="$public_dns" \
		NETMON_RETENTION_DAYS="$retention_days" \
		NETMON_MEMORY_LIMIT="$memory_limit" \
		NETMON_THREADS="$threads" \
		NETMON_DNS_LOG="$dns_log"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger netmon
}
